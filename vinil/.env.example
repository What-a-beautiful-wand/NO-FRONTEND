# Local development credentials only. Change before using outside your machine.
POSTGRES_DB=vinil
POSTGRES_USER=vinil
POSTGRES_PASSWORD=vinil_local
FRONTEND_PORT=8080
BACKEND_PORT=8000
SEED_MOCK_DATA=true
# Used when starting the API outside Docker; Compose supplies its own database host.
DATABASE_URL=postgresql://vinil:vinil_local@localhost:5432/vinil
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Store settings
SESSION_HOURS=168
DELIVERY_FEE=390
FREE_DELIVERY_FROM=10000
PICKUP_ADDRESS="Адрес самовывоза уточнит менеджер"
# For a local API only; Compose uses /app/uploads in a persistent volume.
# MEDIA_ROOT=./static/uploads
